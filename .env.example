# Copy to .env and adjust for your environment.
# Local dev defaults to SQLite so the app runs with zero setup.
# Docker / production should point at Postgres.
DATABASE_URL=postgresql+psycopg://linksnap:linksnap@localhost:5432/linksnap
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SHORT_CODE_LENGTH=7
LRU_CACHE_SIZE=10000
